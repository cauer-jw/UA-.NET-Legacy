  <Target Name="PrepareDeploymentDirectory" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <MakeDir Directories="$(DeploymentDir)" />
    <ItemGroup>
      <_DeploymentFilesToDelete Include="$(DeploymentDir)**\*.*"
                                Exclude="$(DeploymentDir)Opc.Ua.ComServerWrapper.Config.xml" />
    </ItemGroup>
    <Delete Files="@(_DeploymentFilesToDelete)" Condition="'@(_DeploymentFilesToDelete)' != ''" />
  </Target>
  <Target Name="CreateDeployment" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_DeploymentRuntimeReferences Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll' or '%(ReferenceCopyLocalPaths.Extension)' == '.exe'" />
      <_DeploymentReferenceDirectories Include="@(_DeploymentRuntimeReferences->'$(DeploymentDir)%(DestinationSubDirectory)')" />
      <_DeploymentContent Include="@(ContentWithTargetPath)" Condition="'%(ContentWithTargetPath.CopyToOutputDirectory)' != '' and '%(ContentWithTargetPath.TargetPath)' != 'Opc.Ua.ComServerWrapper.Config.xml'" />
      <_DeploymentSymbols Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
      <_DeploymentSymbols Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.pdb'" />
    </ItemGroup>
    <MakeDir Directories="$(DeploymentDir)" />
    <MakeDir Directories="@(_DeploymentReferenceDirectories)" Condition="'@(_DeploymentReferenceDirectories)' != ''" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(DeploymentDir)$(TargetFileName)" />
    <Copy SourceFiles="$(TargetDir)$(TargetFileName).config"
          DestinationFiles="$(DeploymentDir)$(TargetFileName).config"
          Condition="Exists('$(TargetDir)$(TargetFileName).config')" />
    <Copy SourceFiles="@(_DeploymentRuntimeReferences)"
          DestinationFiles="@(_DeploymentRuntimeReferences->'$(DeploymentDir)%(DestinationSubDirectory)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false"
          Condition="'@(_DeploymentRuntimeReferences)' != ''" />
    <Copy SourceFiles="@(_DeploymentContent->'$(TargetDir)%(TargetPath)')"
          DestinationFiles="@(_DeploymentContent->'$(DeploymentDir)%(TargetPath)')"
          SkipUnchangedFiles="false"
          Condition="'@(_DeploymentContent)' != ''" />
        <Copy SourceFiles="$(TargetDir)Opc.Ua.ComServerWrapper.Config.xml"
          DestinationFiles="$(DeploymentDir)Opc.Ua.ComServerWrapper.Config.xml"
          Condition="Exists('$(TargetDir)Opc.Ua.ComServerWrapper.Config.xml') and !Exists('$(DeploymentDir)Opc.Ua.ComServerWrapper.Config.xml')" />
    <MakeDir Directories="$(DeploymentDir)Symbols" Condition="'@(_DeploymentSymbols)' != ''" />
    <Copy SourceFiles="@(_DeploymentSymbols)"
          DestinationFiles="@(_DeploymentSymbols->'$(DeploymentDir)Symbols\%(Filename)%(Extension)')"
          SkipUnchangedFiles="false"
          Condition="'@(_DeploymentSymbols)' != ''" />
  </Target>
